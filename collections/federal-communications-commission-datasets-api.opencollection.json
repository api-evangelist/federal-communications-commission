{
  "opencollection": "1.0.0",
  "info": {
    "name": "FCC ECFS Datasets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List datasets in the FCC open data catalog",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://publicapi.fcc.gov/ecfs/api/views.json",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of datasets and views available on the FCC Open Data portal."
        }
      ]
    }
  ],
  "bundled": true
}